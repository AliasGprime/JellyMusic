# JellyMusic : le navigateur revérifie la page et le code à chaque visite
# (requête légère si rien n'a changé). Après une mise à jour, tout le monde
# reçoit donc la nouvelle version sans avoir à faire Ctrl+F5.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|json|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

AddType application/wasm .wasm
